# ========================= LLM 配置 =========================
# LLM 服务地址，例如 http://localhost:8888/v1
LLM_BASE_URL=your-api-base-url
# LLM 的 API Key
LLM_API_KEY=your-api-key
# LLM 模型名称，例如 claude-4.6-opus
LLM_MODEL_ID=your-model-name
## 温度参数 [0.0,2.0]
#LLM_TEMPERATURE=0.7
## 请求超时时间（秒），(0,+∞)
#LLM_REQUEST_TIMEOUT=600
## 最大生成 token 数，None 表示不限制
#LLM_MAX_TOKENS=None

# ========================= 系统 配置 =========================
# 是否开启调试模式
DEBUG=False
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# ========================= 历史管理 配置 =========================
## 最大对话历史长度 [10,1000]
#MAX_HISTORY_LENGTH=100

# ========================= 上下文工程 配置 =========================
## 上下文窗口大小（tokens）
#CONTEXT_WINDOW=128000
## 压缩阈值（0.8 = 80%时触发压缩）
#COMPRESSION_THRESHOLD=0.8
## 压缩时保留的最小完整轮次数
#MIN_RETAIN_ROUNDS=10
# 是否启用智能摘要（需要额外LLM调用）
ENABLE_SMART_COMPRESSION=False

# ========================= 智能摘要 配置 =========================
# 摘要专用 LLM 服务地址，例如 http://localhost:8888/v1
SUMMARY_LLM_BASE_URL=LLM_BASE_URL
# 摘要专用 LLM 的 API Key
SUMMARY_LLM_API_KEY=LLM_API_KEY
# 摘要专用 LLM 模型名称，例如 claude-4.6-sonnet
SUMMARY_LLM_MODEL_ID=LLM_MODEL_ID
## 摘要 生成温度（更确定性）
#SUMMARY_LLM_TEMPERATURE=0.3
## 摘要 请求超时时间（秒），(0,+∞)
#SUMMARY_LLM_REQUEST_TIMEOUT=600
## 摘要 最大 Token 数
#SUMMARY_LLM_MAX_TOKENS=800

# ========================= 工具输出截断 配置 =========================
## 工具输出最大行数
#TOOL_OUTPUT_MAX_LINES=2000
## 工具输出最大字节数（50KB）
#TOOL_OUTPUT_MAX_BYTES=51200
# 完整输出保存目录
TOOL_OUTPUT_DIR="output/tool-output"
## 截断方向：head/tail/head_tail
#TOOL_OUTPUT_TRUNCATE_DIRECTION="head"

# ========================= 可观测性 配置 =========================
# 是否启用 Trace 记录
TRACE_ENABLED=True
# Trace 文件保存目录
TRACE_DIR="output/memory/traces"
## 是否脱敏敏感信息
#TRACE_SANITIZE=True
## HTML 是否包含原始响应
#TRACE_HTML_INCLUDE_RAW_RESPONSE=False

# ========================= Skills 知识外化 配置 =========================
# 是否启用 Skills 系统
SKILLS_ENABLED=True
# Skills 目录路径
SKILLS_DIR="skills"
## 是否自动注册 SkillTool
#SKILLS_AUTO_REGISTER=True

# ========================= 熔断器 配置 =========================
## 是否启用熔断器
#CIRCUIT_ENABLED=True
## 连续失败多少次后熔断
#CIRCUIT_FAILURE_THRESHOLD=3
## 熔断后恢复时间（秒）
#CIRCUIT_RECOVERY_TIMEOUT=300

# ========================= 会话持久化 配置 =========================
## 是否启用会话持久化
#SESSION_ENABLED=True
# 会话文件保存目录
SESSION_DIR="output/memory/sessions"
# 是否启用自动保存
AUTO_SAVE_ENABLED=False
# 自动保存间隔（每N条消息）
AUTO_SAVE_INTERVAL=10

# ========================= 子代理机制 配置 =========================
## 是否启用子代理机制
#SUBAGENT_ENABLED=True
## 子代理默认最大步数
#SUBAGENT_MAX_STEPS=15
# 是否使用轻量模型（默认关闭，避免破坏现有行为）
SUBAGENT_USE_LIGHT_LLM=False
# 轻量 LLM 服务地址，例如 http://localhost:8888/v1
SUBAGENT_LIGHT_LLM_BASE_URL=LLM_BASE_URL
# 轻量 LLM 的 API Key
SUBAGENT_LIGHT_LLM_API_KEY=LLM_API_KEY
# 轻量 LLM 模型名称，例如 claude-4.6-haiku
SUBAGENT_LIGHT_LLM_MODEL_ID=LLM_MODEL_ID
## 轻量 温度参数 [0.0,2.0]
#SUBAGENT_LIGHT_LLM_TEMPERATURE=0.7
## 轻量 请求超时时间（秒），(0,+∞)
#SUBAGENT_LIGHT_LLM_REQUEST_TIMEOUT=600
## 轻量 最大生成 token 数，None 表示不限制
#SUBAGENT_LIGHT_LLM_MAX_TOKENS=None

# ========================= TodoWrite 配置 =========================
## 是否启用 TodoWrite 工具
#TODOWRITE_ENABLED=True
# 任务列表持久化目录
TODOWRITE_PERSISTENCE_DIR="output/memory/todos"

# ========================= DevLog 配置 =========================
## 是否启用 DevLog 工具
#DEVLOG_ENABLED=True
# 开发日志持久化目录
DEVLOG_PERSISTENCE_DIR="output/memory/devlogs"

# ========================= 异步生命周期 配置 =========================
## 是否启用异步执行
#ASYNC_ENABLED=True
## 最大并发工具数
#MAX_CONCURRENT_TOOLS=3
## 生命周期钩子超时时间（秒）
#HOOK_TIMEOUT_SECONDS=5.0
## LLM 异步调用超时时间（秒）
#LLM_ASYNC_TIMEOUT=120
## 工具异步调用超时时间（秒）
#TOOL_ASYNC_TIMEOUT=30

# ========================= 流式输出 配置 =========================
## 是否启用流式输出
#STREAM_ENABLED=True
## 流式缓冲区大小
#STREAM_BUFFER_SIZE=100
## 是否包含思考过程
#STREAM_INCLUDE_THINKING=True
## 是否包含工具调用
#STREAM_INCLUDE_TOOL_CALLS=True

# ========================= 工具 配置 =========================
# ============ 搜索 ============
# Tavily
TAVILY_API_KEY=your_tavily_key
# SerpApi
SERPAPI_API_KEY=your_serpapi_key
# Perplexity
PERPLEXITY_API_KEY=your_perplexity_key

# ========================= Qdrant 向量数据库 配置 =========================
# Qdrant 服务地址（云服务或本地），例如 https://your-cluster.qdrant.tech:6333 或 http://localhost:6333
QDRANT_URL=
# Qdrant API Key（云服务必填，本地可为空）
QDRANT_API_KEY=
# Qdrant 向量集合名称
QDRANT_COLLECTION_NAME="sibuchen_agents_vectors"
## 向量维度大小
#QDRANT_VECTOR_SIZE=384
## 向量距离度量方式：cosine / euclidean / dot
#QDRANT_DISTANCE="cosine"
## Qdrant 请求超时时间（秒）
#QDRANT_TIMEOUT=30

# ========================= Neo4j 图数据库 配置 =========================
# Neo4j 连接 URI（Aura 云 或 本地 bolt 协议），例如 neo4j+s://your-instance.databases.neo4j.io 或 bolt://localhost:7687
NEO4J_URI=
# Neo4j API Key（云服务必填，本地可为空）
NEO4J_API_KEY=
# Neo4j 用户名
NEO4J_USERNAME="sibuchen"
# Neo4j 密码
NEO4J_PASSWORD="sibuchenagnets-neo4j-password"
## Neo4j 数据库名称
#NEO4J_DATABASE="neo4j"
## Neo4j 最大连接生命周期（秒）
#NEO4J_MAX_CONNECTION_LIFETIME=3600
## Neo4j 最大连接池大小
#NEO4J_MAX_CONNECTION_POOL_SIZE=50
## Neo4j 连接超时时间（秒）
#NEO4J_CONNECTION_TIMEOUT=60

# ========================= 嵌入（Embedding）模型 配置 =========================
# 嵌入模型类型：dashscope / local / tfidf
EMBED_MODEL_TYPE="dashscope"
# 嵌入模型 Base URL（可选，自定义 endpoint 时使用）
EMBED_MODEL_BASE_URL=
# 嵌入模型 API Key
EMBED_MODEL_API_KEY=
# 嵌入模型名称（为空时，使用各类型默认模型）
EMBED_MODEL_ID=""

# ========================= IM 配置（NoneBot2 多平台即时通讯）=========================
# 是否启用 IM Bot Server（需同时安装 nonebot2[fastapi] 及对应适配器）
IM_ENABLED=false
# IM Bot Server 监听地址
IM_HOST=0.0.0.0
# IM Bot Server 监听端口（与主程序端口区分开）
IM_PORT=8765
# IM 使用的 Agent 类型：react / reflection / plan / simple / function_call / tool_aware
IM_AGENT_TYPE=function_call
# 是否为每个用户创建独立的 Agent 实例（True = 每用户独立历史）
IM_SESSION_ISOLATION=true
# 白名单：允许使用 Bot 的用户 ID，逗号分隔（留空表示不限制）
IM_WHITELIST=
# 每分钟每用户最大请求数（0 表示不限流）
IM_RATE_LIMIT=10

# ---------- Telegram 适配器 ----------
# Telegram Bot Token（来自 @BotFather: https://t.me/BotFather）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---------- 飞书（Feishu / Lark）适配器 ----------
# 飞书开放平台 App ID（https://open.feishu.cn/）
FEISHU_APP_ID=
# 飞书开放平台 App Secret
FEISHU_APP_SECRET=
# 飞书 Webhook Verification Token（推荐在生产环境配置，增强安全）
FEISHU_VERIFICATION_TOKEN=